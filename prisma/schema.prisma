generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  username      String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  portfolios    Portfolio[]
  accounts      Account[]
  sessions      Session[]
  visitsMade    ProfileVisit[] @relation("VisitorUser")
  aiUsage       AiUsage[]
  aiUsageEvents AiUsageEvent[]
  portfolioDraft PortfolioDraft?
}

model PortfolioDraft {
  userId    String   @id
  snapshot  Json
  revision  Int      @default(1)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Keep tombstones after deletion so stale drafts cannot republish deleted files.
// No cascading user FK: abandoned uploads still need cleanup after account removal.
model ProjectUpload {
  id          String    @id
  ownerId     String
  storageBase String
  bucket      String
  paths       String[]
  urls        String[]
  status      String    @default("active")
  unusedSince DateTime? @default(now()) @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, unusedSince])
  @@index([ownerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Portfolio {
  id               String         @id @default(cuid())
  content          Json
  publicSlug       String         @unique
  isPublicOnSearch Boolean        @default(false)
  userId           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageViews        PageView[]
  profileVisits    ProfileVisit[]
  actions          PortfolioAction[]

  @@index([userId])
  @@index([isPublicOnSearch])
}

model PageView {
  id               String   @id @default(cuid())
  portfolioId      String
  visitorSessionId String?
  createdAt        DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([visitorSessionId])
}

model PortfolioAction {
  id          String   @id
  portfolioId String
  action      String
  projectId   String?
  target      String?
  visitorHash String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
}

model ProfileVisit {
  id               String   @id @default(cuid())
  portfolioId      String
  visitorId        String?
  visitorSessionId String
  count            Int      @default(1)
  lastSeen         DateTime @default(now()) @updatedAt
  createdAt        DateTime @default(now())
  visitorCountry   String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  visitor   User?     @relation("VisitorUser", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, visitorSessionId])
  @@index([portfolioId])
  @@index([visitorId])
}

model AiUsage {
  id          String   @id @default(cuid())
  userId      String
  action      String
  usageDate   DateTime @db.Date
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, usageDate])
  @@index([userId, usageDate])
}

model AiUsageEvent {
  id               String   @id @default(cuid())
  userId           String
  action           String
  status           String
  inputCharacters  Int
  outputCharacters Int?
  durationMs       Int?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AiGlobalUsage {
  id               String    @id @default(cuid())
  usageDate        DateTime  @unique @db.Date
  count            Int       @default(0)
  unavailableUntil DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz

  @@index([resetAt])
}
