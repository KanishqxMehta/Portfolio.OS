generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  username      String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  portfolios    Portfolio[]
  accounts      Account[]
  sessions      Session[]
  visitsMade    ProfileVisit[] @relation("VisitorUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id          String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Portfolio {
  id            String         @id @default(cuid())
  content       Json
  publicSlug    String         @unique
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageViews     PageView[]
  profileVisits ProfileVisit[]

  @@index([userId])
}

model PageView {
  id               String   @id @default(cuid())
  portfolioId      String
  visitorSessionId String?
  createdAt        DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([visitorSessionId])
}

model ProfileVisit {
  id               String   @id @default(cuid())
  portfolioId      String
  visitorId        String?
  visitorSessionId String
  count            Int      @default(1)
  lastSeen         DateTime @default(now()) @updatedAt
  createdAt        DateTime @default(now())
  visitorCountry   String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  visitor   User?     @relation("VisitorUser", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, visitorSessionId])
  @@index([portfolioId])
  @@index([visitorId])
}