# Database (local Docker Compose defaults shown)
DATABASE_URL=postgresql://devuser:devpassword@127.0.0.1:5432/placement_db
DEV_DATABASE_URL=postgresql://devuser:devpassword@127.0.0.1:5432/placement_db
PROD_DATABASE_URL=

# App environment: development | production
APP_ENV=development
NODE_ENV=development

# Public site URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional SMTP (contact form + password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# Production Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional project screenshot uploads. Create a PUBLIC bucket first.
# Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_IMAGES_BUCKET=project-images

# Daily unused-upload cleanup (disabled/dry-run until explicitly enabled).
CRON_SECRET=
PROJECT_UPLOAD_CLEANUP_ENABLED=false
